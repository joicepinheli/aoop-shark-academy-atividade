        <name>x_1882391_social_0.buildIndicatorHtml_li</name>
        <script><![CDATA[// UI Script: buildIndicatorHtml_lib
// Application: Social Media Management
(function(window, undefined) {
  // evita redefinir se já existir
  if (window.buildIndicatorHtml && typeof window.buildIndicatorHtml === 'function') {
    return;
  }

  // estilos reutilizáveis
  function stepStyle() { return 'padding:4px 8px;border-radius:4px;background:#eee;color:#333;'; }
  function doneStyle() { return 'padding:4px 8px;border-radius:4px;background:#2ecc71;color:#fff;'; }
  function activeStyle() { return 'padding:4px 8px;border-radius:4px;background:#3498db;color:#fff;'; }

  // função exposta globalmente
  window.buildIndicatorHtml = function(state) {
    // normaliza null/undefined e padroniza capitalização
    state = state ? state.toString() : '';
    // se seus valores de state forem sys_id ou labels diferentes, ajuste aqui

    var draftDone = (state === 'Published' || state === 'Follow-up' || state === 'Closed');
    var publishedDone = (state === 'Follow-up' || state === 'Closed');
    var followUpDone = (state === 'Closed');

    var s = '<div class="progress-indicator" style="display:flex;gap:8px;align-items:center;font-weight:600;">';
    s += '<span style="' + (draftDone ? doneStyle() : (state === 'Draft' ? activeStyle() : stepStyle())) + '">Draft</span>';
    s += '<span style="margin:0 6px;">➡</span>';
    s += '<span style="' + (publishedDone ? doneStyle() : (state === 'Published' ? activeStyle() : stepStyle())) + '">Published</span>';
    s += '<span style="margin:0 6px;">➡</span>';
    s += '<span style="' + (followUpDone ? doneStyle() : (state === 'Follow-up' ? activeStyle() : stepStyle())) + '">Follow-up</span>';
    s += '<span style="margin:0 6px;">➡</span>';
    s += '<span style="' + (state === 'Closed' ? activeStyle() : stepStyle()) + '">Closed</span>';
    s += '</div>';
    return s;
  };

})(window);]]></script>
